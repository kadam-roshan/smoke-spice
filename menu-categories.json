{
  "meta": {
    "name": "menu-categories-seed",
    "extends": "restaurant-menu-design-system.json",
    "description": "Category structure for the menu. Plugs into data_schema.menu.categories of the design system. Items are intentionally empty.",
    "total_categories": 19
  },
  "settings": {
    "currency": "INR",
    "locale": "en-IN",
    "price_format": {
      "symbol": "₹",
      "position": "prefix",
      "minimum_fraction_digits": 0,
      "note": "Set to 2 to mirror the 2-decimal style of the reference design."
    }
  },
  "ui_extensions": {
    "note": "The reference design has ~4-5 tabs. With 19 categories the tab bar needs help. These rules extend, not replace, the design system.",
    "diet_filter": {
      "component": "segmented control / chips row placed between brand_header and category_tab_bar",
      "options": [
        {
          "id": "all",
          "label": "All"
        },
        {
          "id": "veg",
          "label": "Veg"
        },
        {
          "id": "non_veg",
          "label": "Non Veg"
        }
      ],
      "default": "all",
      "behavior": "Filters the tab bar and the section list. Categories with diet 'both' are always visible.",
      "style": "pill chips, height 32, radius 16, inactive: bg surface.tab_bar + text.tab_inactive, active: bg brand.accent + text.on_accent, font 13/600"
    },
    "tab_bar": {
      "label_source": "short_label (diet prefix dropped when a diet filter is active; kept in 'All' mode)",
      "auto_scroll_active_tab_into_view": true,
      "scroll_snap": "proximity",
      "fade_edge": "16px white-to-transparent gradient on the right edge to hint more tabs"
    },
    "veg_indicator": {
      "purpose": "Regulatory-style dietary mark shown on every item row, before the item name.",
      "shape": "14x14 square, 1.5px border, radius 2px, centered 8px filled circle",
      "veg": {
        "color": "#0F8A3C"
      },
      "non_veg": {
        "color": "#B3261E"
      },
      "exception_note": "These two colors are semantic indicators and are the ONLY allowed exceptions to the single-accent rule. Never use them for decoration.",
      "placement": "inline, 6px gap before item_name, vertically centered to first line"
    },
    "section_ordering": "Render sections in the order field below. When the diet filter is 'all', insert a subtle group label ('Veg' / 'Non Veg' / 'Breads & Packs') using section_subtitle styling before the first section of each group.",
    "family_pack_card": "Optional: items in the family-pack category may show a small muted 'serves N' label under the price using price_variant_label style."
  },
  "groups": [
